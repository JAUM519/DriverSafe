# MongoDB Atlas (se usa para configurar el nodo "DriverSafe MongoDB" en Node-RED)
MONGODB_URI="mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/"

# MQTT (Maqiatto)
MQTT_BROKER=maqiatto.com
MQTT_PORT=1883
MQTT_USER=<correo-registrado-en-maqiatto>
MQTT_PASSWORD="<contraseña>"

# Simulador
DRIVER_ID=BUS01-COND01

# Aplicación web
VITE_NODE_RED_URL=http://localhost:1880

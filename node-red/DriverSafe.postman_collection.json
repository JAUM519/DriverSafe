{
  "info": {
    "name": "DriverSafe IoT - API Node-RED",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Endpoints REST implementados en Node-RED (pestaña API REST). Ejecuta primero «Iniciar sesión»: guarda el token en la variable {{token}}."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:1880"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Sesión",
      "item": [
        {
          "name": "Iniciar sesión",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/driversafe/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driversafe",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"supervisor\",\n  \"clave\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set(\"token\", pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar sesión",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/driversafe/sesion",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driversafe",
                "sesion"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Cerrar sesión",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/driversafe/sesion",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "driversafe",
                "sesion"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
